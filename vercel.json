{
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/blink", "destination": "/api/live" }],
  "functions": { "api/live.py": { "maxDuration": 300, "includeFiles": "{pipeline/blink/**,pipeline/data/**,web/public/showcase/**/meta.json}" } }
}
